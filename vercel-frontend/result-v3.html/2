<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>访谈结果 - V3</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .header h1 {
            color: #333;
            margin-bottom: 10px;
        }
        .status {
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            font-weight: 500;
        }
        .status.loading { background: #fff3cd; color: #856404; }
        .status.success { background: #d4edda; color: #155724; }
        .status.error { background: #f8d7da; color: #721c24; }
        .section {
            margin: 20px 0;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        .section h2 {
            color: #333;
            margin-bottom: 15px;
        }
        pre {
            background: white;
            padding: 15px;
            border-radius: 6px;
            overflow-x: auto;
            font-size: 12px;
            line-height: 1.6;
        }
        .btn {
            display: inline-block;
            padding: 10px 20px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            margin: 5px;
        }
        .hidden { display: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 访谈结果</h1>
            <div id="status" class="status loading">正在加载...</div>
        </div>
        
        <div id="debug" class="section hidden">
            <h3>🔍 调试信息</h3>
            <pre id="debugContent"></pre>
        </div>
        
        <div id="result" class="section hidden">
            <h3>📋 访谈结果</h3>
            <pre id="resultContent"></pre>
            <div style="text-align: center; margin-top: 20px;">
                <a href="/" class="btn">开始新访谈</a>
                <button onclick="exportJSON()" class="btn">导出JSON</button>
            </div>
        </div>
    </div>

    <script>
        // 配置
        const API_BASE_URL = 'https://ai-interview-agentai-interview.onrender.com';
        
        // 获取session_id
        const urlParams = new URLSearchParams(window.location.search);
        const sessionId = urlParams.get('session_id') || '20260317134309-BD'; // 默认值
        
        // 调试日志
        function debug(msg) {
            console.log(msg);
            const debugDiv = document.getElementById('debugContent');
            const debugSection = document.getElementById('debug');
            debugSection.classList.remove('hidden');
            debugDiv.textContent += new Date().toLocaleTimeString() + ' - ' + msg + '\n';
        }
        
        // 更新状态
        function setStatus(msg, type) {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = msg;
            statusDiv.className = 'status ' + type;
        }
        
        // 显示结果
        function showResult(data) {
            const resultSection = document.getElementById('result');
            const resultContent = document.getElementById('resultContent');
            resultSection.classList.remove('hidden');
            resultContent.textContent = JSON.stringify(data, null, 2);
        }
        
        // 主函数
        async function loadResult() {
            try {
                debug('开始加载访谈结果');
                debug('Session ID: ' + sessionId);
                debug('API URL: ' + API_BASE_URL);
                
                setStatus('正在从服务器获取数据...', 'loading');
                
                // 发起API请求
                const url = API_BASE_URL + '/api/interview/' + sessionId;
                debug('请求URL: ' + url);
                
                const response = await fetch(url);
                debug('响应状态: ' + response.status);
                
                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }
                
                const data = await response.json();
                debug('数据解析成功');
                debug('Success: ' + data.success);
                
                if (data.success && data.result) {
                    const r = data.result;
                    debug('数据完整: 工作阶段=' + (r.workflow_map?.length || 0) + ', 最佳实践=' + (r.best_practices?.length || 0));
                    
                    setStatus('✅ 加载成功！', 'success');
                    showResult(data);
                } else {
                    throw new Error('API返回success=false');
                }
                
            } catch (error) {
                debug('错误: ' + error.message);
                debug('错误详情: ' + error.stack);
                
                setStatus('❌ 加载失败: ' + error.message, 'error');
                
                // 显示调试信息
                const debugSection = document.getElementById('debug');
                debugSection.classList.remove('hidden');
                
                console.error('完整错误:', error);
            }
        }
        
        // 导出JSON
        function exportJSON() {
            const resultContent = document.getElementById('resultContent').textContent;
            if (!resultContent) {
                alert('没有可导出的数据');
                return;
            }
            const blob = new Blob([resultContent], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'interview_result.json';
            a.click();
        }
        
        // 页面加载后自动执行
        window.addEventListener('load', () => {
            debug('页面已加载');
            debug('当前Origin: ' + window.location.origin);
            debug('完整URL: ' + window.location.href);
            
            // 延迟一点执行，确保DOM准备好
            setTimeout(loadResult, 100);
        });
    </script>
</body>
</html>
